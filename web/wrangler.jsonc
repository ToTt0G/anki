{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klanki",
  "main": "server/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "klanki.ezryder.us",
      "custom_domain": true
    }
  ],
  "vars": {
    "CLERK_PUBLISHABLE_KEY": "pk_test_bGVnYWwtcHVtYS04NjY0LmNsZXJrLmFjY291bnRzLmRldiQ",
    "VAPID_PUBLIC_KEY": "BMvc07ap8EiEgS3O3upQee-f8UUuB2pDgaaNoZtkx4pxxURiZUh-WEhCDo_NYfrnqYvXrVyMj2NiPfwSI9aV6WM",
    "VAPID_SUBJECT": "mailto:rainryder4@gmail.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ANKI_SYNC",
        "class_name": "AnkiSyncServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AnkiSyncServer"]
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
